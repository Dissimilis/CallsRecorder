#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest" // 24 = RT_MANIFEST; the symbol itself may not resolve under windres

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,1,0
PRODUCTVERSION  1,2,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "CallsRecorder - system tray call recorder"
      VALUE "FileVersion", "1.2.1.0"
      VALUE "InternalName", "CallsRecorder"
      VALUE "OriginalFilename", "CallsRecorder.exe"
      VALUE "ProductName", "CallsRecorder"
      VALUE "ProductVersion", "1.2.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
